{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[watch\\]",
          "endsPattern": "build finished"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
